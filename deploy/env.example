# Symphony 部署配置模板。
# 复制为 .env 后填写：./deploy.sh init
# .env 已在 deploy/.gitignore 里忽略，不会进仓库。

# ---------------------------------------------------------------------------
# 业务仓库：Agent 的工作区会克隆这个仓库
# ---------------------------------------------------------------------------
APP_REPO_URL=http://192.168.175.55:9888/mijiuye/iidp-aios.git
# 需要直接检出的分支；留空则用仓库默认分支
APP_REPO_BRANCH=

# 内网 GitLab 的 HTTP 凭据（PAT 或账号密码）。
# 填了之后 entrypoint 会写入 ~/.git-credentials，Agent 可以 clone / push。
GIT_USERNAME=
GIT_TOKEN=

# Agent 提交使用的身份
GIT_AUTHOR_NAME=Symphony Agent
GIT_AUTHOR_EMAIL=symphony-agent@localhost

# ---------------------------------------------------------------------------
# Agent 模型：OpenAI 兼容网关（one-api）
# ---------------------------------------------------------------------------
# 填了这两项后，entrypoint 会把同一套网关配置展开到各 CLI：
#   codex  -> ~/.codex/config.toml（model_provider = oneapi，wire_api = responses）
#   claude -> ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_MODEL
#   zcode  -> ~/.zcode/cli/custom.env（provider kind = anthropic）
# cursor-agent 走 Cursor 私有协议（api2.cursor.sh），无法指向 OpenAI 兼容网关，
# 只能用它自己的 CURSOR_API_KEY 登录态。
#
# 两者留空则跳过生成，各 CLI 沿用自己已登录的账号与默认模型。
OPENAI_BASE_URL=https://one-api.sd.sieiot.com/v1
# 密钥只写进 .env（已被 deploy/.gitignore 忽略），不要把真实密钥提交到仓库
OPENAI_API_KEY=
# 主模型 / 轻量模型：填网关 /v1/models 里的 id
# 可选值（本地部署）：local-glm5.3、local-glm5.3-flash、local-glm5.2-fp8、
#                    local-qwen3.5、local-qwen3-32b、local-qwen3-vl-30b ...
AGENT_MODEL=local-glm5.3
AGENT_LITE_MODEL=local-glm5.3
# 模型的上下文窗口（token）。网关不返回模型元数据，codex 只能退回兜底值，
# 这里显式声明可让自动压缩更准；不确定就留空，让 CLI 用默认值。
AGENT_MODEL_CONTEXT_WINDOW=200000
# 只有走 cursor 通道时才需要；也可以把本机 ~/.cursor 挂进 auth/cursor
CURSOR_API_KEY=

# ---------------------------------------------------------------------------
# 渠道：善治（SF 软件工厂）
# ---------------------------------------------------------------------------
SF_BASE_URL=https://api.gushen.sieiot.com
SF_USERNAME=
SF_PASSWORD=
SF_PRODUCT_ID=
SF_PROJECT_ID=
SF_DEP_ID=
# 善治前端地址，用于日志与 Bug 链接（例：http://sf.sieiot.com）
SF_WEB_URL=
# 只派发指派给此人的 Bug（姓名或 11 位手机号），留空则不限
# 与 WORKFLOW.md 里的 require_confirmed 是「与」关系：两者交集为空就派发 0 单
SF_ASSIGNEE=

# ---------------------------------------------------------------------------
# 善治 MCP 服务（独立仓库，stdio 传输）
# ---------------------------------------------------------------------------
# 镜像里会装 https://.../shanzhi_mcp.git 的 MCP 服务，entrypoint 用上面的
# SF_* 生成它的凭证配置，并注册到 codex / claude。
#
# 注意与 Symphony 内置工具的分工：
#   Symphony /mcp  -> shanzhi_get_bug / bug_history / confirm / remark / resolve
#   独立 MCP 服务  -> find_bugs / list_members / list_projects / create_bug ...
# 内置工具刻意不含「提 Bug」，独立服务默认也只开放只读工具，避免自治 Agent
# 往生产缺陷库里建 Bug。
SHANZHI_MCP_ENABLED=1
# readonly（默认）：只开放 find_bugs / get_bug / get_bug_history /
#                   list_members / list_projects
# all：额外开放 create_bug / resolve_bug / confirm_bug / remark_bug
SHANZHI_MCP_TOOLS=readonly
# 构建参数：MCP 服务仓库与分支。置空跳过安装。
SHANZHI_MCP_REPO=http://192.168.175.55:9888/mijiuye/shanzhi_mcp.git
SHANZHI_MCP_REF=master

# ---------------------------------------------------------------------------
# IIDP 开发环境（app-test）发版凭据
# ---------------------------------------------------------------------------
# deploy/publish_dev.sh 只往这里发版；演示环境（:30680）会被脚本闸门直接拒绝。
# 这些值经 Secret symphony-env 进容器环境，Agent 与发版脚本都只读环境变量，
# 所以 WORKFLOW.md 和脚本正文里不会出现明文凭据。
IIDP_BASE=http://192.168.181.104:30669
# 开发环境的登录账号（口令从环境变量读，不落到任何文件）
IIDP_USER=implementer
IIDP_PASSWORD=
# 内置应用（de.source=base，如 sie-iidp-de-post-dev / employee-implementer）
# 无法走市场 updateApps，只能用恢复通道 /api/recovery/app/save 更新，
# 该通道需要 superuser 的 token。取值：new_apptest 库 rbac_token 表
# id='rbac_token_superuser' 那行的 token，长期固定。
# 也可用 IIDP_SUPERUSER_TOKEN_FILE 指向一个文件（不要把 token 提交进仓库）。
IIDP_SUPERUSER_TOKEN=
# 跨工作区的发版互斥锁：放工作区卷上，Pod 重建后仍保留。
# 两个 Agent 同时发版时，后启动的一方会在构建前失败。
PUBLISH_LOCK_DIR=/data2/locks

# ---------------------------------------------------------------------------
# 服务
# ---------------------------------------------------------------------------
SYMPHONY_PORT=4567
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------
IMAGE_NAME=symphony-agent
IMAGE_TAG=latest
CONTAINER_NAME=symphony
# 部署机一般是 x86_64 服务器，默认按 linux/amd64 构建。
# 在 Apple Silicon 上本地跑改成 linux/arm64 更快（跨架构构建要走 QEMU，非常慢）。
# 留空表示用本机架构。
TARGET_PLATFORM=linux/amd64

# 内网无外网时换成私有 npm 镜像，例如 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# Agent CLI 版本（默认 latest；要可复现构建就钉死版本号）
CODEX_VERSION=latest
CLAUDE_CODE_VERSION=latest
# ZCode 官方只发桌面版，这里用社区整理的运行时安装包；置空跳过安装。
# 社区 CLI 不认适配器的 --output-format，镜像里会用 zcode-stream-shim.sh 顶替 zcode。
ZCODE_CLI_PKG=https://github.com/xhqing/zcode-cli/releases/download/v3.8.1-32/zcode-cli-3.8.1-32.tgz
CURSOR_INSTALL_URL=https://cursor.com/install
